---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import RootLayout from "./RootLayout.astro";
import "../styles/comentario.css";
import ViewCount from "../components/ViewCount.astro";

type Props = CollectionEntry<"blog">["data"] & {
  frontmatter: Record<string, any>;
};

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const { minutesRead } = Astro.props.frontmatter;
const slug = Astro.params.slug ?? "";
---

<RootLayout
  meta={{ title: `derock.blog: ${title}`, description, image: heroImage }}
>
  <Header />
  <main>
    <article class="leading-[1.7]">
      <!-- top header -->
      <div class="max-w-4xl px-8 m-auto sm:pt-4 text-white">
        <div class="py-4 text-center leading-none">
          <div class="mb-4">
            <FormattedDate date={pubDate} />
            {" "}•{" "}
            {minutesRead}
            {" "}•{" "}
            <ViewCount server:defer postId={slug}>
              <span slot="fallback">...</span>
            </ViewCount>
            views

            {
              updatedDate && (
                <div class="italic">
                  Last updated on <FormattedDate date={updatedDate} />
                </div>
              )
            }
          </div>
          <h1 class="text-4xl text-balance">{title}</h1>
        </div>
      </div>

      <!-- image -->
      <div class="w-full">
        {
          heroImage && (
            <img
              width={1200}
              height={600}
              src={heroImage}
              alt={`Hero image for ${title}`}
              class="block mx-auto rounded-xl shadow-md"
            />
          )
        }
      </div>

      <hr class="my-8 max-w-4xl mx-16 lg:mx-auto border-gray-500" />

      <!-- content -->
      <div class="max-w-4xl px-8 m-auto pb-4">
        <div class="post">
          <slot />
        </div>

        <div class="flex flex-row items-center mt-8 justify-between">
          <a
            href="/"
            class="text-blue-400 hover:text-blue-600 leading-none flex flex-row items-center gap-1"
          >
            <Icon name="mdi:arrow-back" size={24} class="inline-block" /> Home
          </a>

          <!-- to top button -->
          <a
            href="#top"
            class="text-blue-400 hover:text-blue-600l leading-none flex flex-row items-center gap-1"
          >
            <Icon name="mdi:arrow-up" size={24} class="inline-block" /> Top
          </a>
        </div>

        <comentario-comments theme="dark"></comentario-comments>
      </div>
    </article>
  </main>

  <Footer />

  <script is:inline defer src="https://comments.derock.blog/comentario.js"
  ></script>
</RootLayout>
