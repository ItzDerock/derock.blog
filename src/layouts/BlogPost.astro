---
import type { MarkdownHeading } from "astro";
import type { CollectionEntry } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import RootLayout from "./RootLayout.astro";
import ViewCount from "../components/ViewCount.astro";
import Spine from "../components/Spine.astro";
import FigureProbe from "../components/FigureProbe.astro";
import { getDesignator } from "../utils/designator";
import "../styles/comentario.css";

type Props = CollectionEntry<"blog">["data"] & {
  frontmatter: Record<string, any>;
  headings: MarkdownHeading[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, headings } =
  Astro.props;
const { minutesRead } = Astro.props.frontmatter;
const slug = (Astro.params as { slug: string }).slug ?? "";
const designator = await getDesignator("blog", slug);
---

<RootLayout
  meta={{
    title: `${title} | derock.blog`,
    description,
    image: heroImage,
    tags,
  }}
>
  <article data-article class="pb-8">
    <!-- Title block: the stamp that names the part and states its parameters. -->
    <header class="mx-auto w-full max-w-board px-5 pt-8 lg:px-8">
      <div class="mb-4 flex items-center gap-3">
        <span class="designator">{designator}</span>
        <span aria-hidden="true" class="h-px flex-1 bg-silk-faint/35"></span>
        <a href="/posts" class="legend text-copper-light no-underline hover:text-gold">
          &larr; all posts
        </a>
      </div>

      <h1 class="max-w-[20ch] font-display text-4xl font-bold text-balance">
        {title}
      </h1>

      {
        description && (
          <p class="mt-3 max-w-[58ch] text-lg text-silk-dim text-balance">
            {description}
          </p>
        )
      }

      <!-- Parameters, set as a legend row rather than a sentence. -->
      <dl
        class="mt-6 flex flex-wrap items-baseline gap-x-6 gap-y-2 border-y
               border-silk-faint/30 py-3"
      >
        <div class="flex items-baseline gap-2">
          <dt class="legend">Published</dt>
          <dd class="font-mono text-data text-silk">
            <FormattedDate date={pubDate} />
          </dd>
        </div>

        {
          updatedDate && (
            <div class="flex items-baseline gap-2">
              <dt class="legend">Revised</dt>
              <dd class="font-mono text-data text-silk">
                <FormattedDate date={updatedDate} />
              </dd>
            </div>
          )
        }

        {
          minutesRead && (
            <div class="flex items-baseline gap-2">
              <dt class="legend">Length</dt>
              <dd class="font-mono text-data text-silk">{minutesRead}</dd>
            </div>
          )
        }

        <div class="flex items-baseline gap-2">
          <dt class="legend">Views</dt>
          <dd class="font-mono text-data text-silk">
            <ViewCount server:defer postId={slug}>
              <span slot="fallback">&hellip;</span>
            </ViewCount>
          </dd>
        </div>

        {
          tags.length > 0 && (
            <div class="flex flex-wrap items-baseline gap-2">
              <dt class="legend">Tags</dt>
              <dd class="flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <a
                    href={`/tags/${tag}`}
                    class="legend rounded-pad border border-silk-faint/35 px-1.5
                           py-0.5 text-silk-dim no-underline transition-colors
                           hover:border-gold hover:text-gold"
                  >
                    {tag}
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>

      <!-- The cover art is a placed part, seated and labelled, never cropped
           into a strip. It was made for this post. -->
      {
        heroImage && (
          <figure class="mt-8">
            <div class="overflow-hidden rounded-part border border-silk-faint/35 bg-mask-deep shadow-part">
              <img
                width={1200}
                height={600}
                src={heroImage}
                alt=""
                class="block h-auto w-full"
              />
            </div>
          </figure>
        )
      }
    </header>

    <div
      class="mx-auto mt-12 w-full max-w-board px-5 lg:grid
             lg:grid-cols-[12rem_minmax(0,1fr)] lg:gap-x-12 lg:px-8"
    >
      <Spine headings={headings} />

      <div class="post min-w-0">
        <slot />

        <footer class="mx-auto mt-16 max-w-column">
          <div class="mb-4 flex items-center gap-3">
            <span class="legend text-copper-light">End of sheet</span>
            <span aria-hidden="true" class="h-px flex-1 bg-silk-faint/35"></span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-4">
            <a href="/posts" class="pad font-mono text-data">
              &larr; all posts
            </a>
            <a href="#top" class="pad font-mono text-data">
              back to top &uarr;
            </a>
          </div>

          <div class="mt-14">
            <div class="mb-4 flex items-center gap-3">
              <span class="legend text-copper-light">Notes</span>
              <span aria-hidden="true" class="h-px flex-1 bg-silk-faint/35"
              ></span>
            </div>
            <comentario-comments theme="dark"></comentario-comments>
          </div>
        </footer>
      </div>
    </div>
  </article>

  <FigureProbe />

  <script is:inline defer src="https://comments.derock.blog/comentario.js"
  ></script>
</RootLayout>
