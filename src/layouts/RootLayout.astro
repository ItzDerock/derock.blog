---
import BaseHead from "../components/BaseHead.astro";

interface Props {
  title: string;
  description: string;
}
---

<html lang="en">
  <head>
    <BaseHead title={Astro.props.title} description={Astro.props.description} />
  </head>
  <body
    class="mx-auto min-h-screen dark dark:bg-background dark:text-white px-1 md:px-4"
  >
    <slot />
  </body>
</html>
