---
import BaseHead, { type Props as BaseHeadProps } from "../components/BaseHead.astro";

interface Props {
  meta: BaseHeadProps; 
}

const headProps = Astro.props.meta;
---

<html lang="en">
  <head>
    <BaseHead {...headProps} />
  </head>
  <body
    class="mx-auto min-h-screen dark dark:bg-background dark:text-white px-1 md:px-4"
  >
    <slot />
  </body>
</html>
