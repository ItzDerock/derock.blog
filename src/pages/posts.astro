---
import { getPublished } from "../utils/content";
import PostRow from "../components/cards/PostRow.astro";
import RootLayout from "../layouts/RootLayout.astro";

const posts = await getPublished("blog");

const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<RootLayout
  meta={{
    title: "All posts | derock.blog",
    description: `${posts.length} posts covering embedded systems, RF, robotics, infrastructure, and security.`,
  }}
>
  <div class="mx-auto w-full max-w-index px-5 pb-4 pt-8 lg:px-8">
    <header class="mb-8">
      <div class="mb-3 flex items-baseline gap-3">
        <span class="legend text-copper-light">Parts list</span>
        <span aria-hidden="true" class="h-px flex-1 bg-silk-faint/35"></span>
        <span class="legend">{posts.length} posts</span>
      </div>
      <h1 class="font-display text-3xl font-bold text-silk">All posts</h1>
    </header>

    {
      tags.length > 0 && (
        <nav aria-label="Tags" class="mb-8 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="legend rounded-pad border border-silk-faint/35 px-2 py-1
                     text-silk-dim no-underline transition-colors
                     hover:border-gold hover:text-gold"
            >
              {tag}
            </a>
          ))}
        </nav>
      )
    }

    <div class="flex flex-col gap-4">
      {posts.map((post) => <PostRow blog={post} />)}
    </div>
  </div>
</RootLayout>
