---
import { type CollectionEntry } from "astro:content";
import { getPublished } from "../../utils/content";
import BitPost from "../../layouts/BitPost.astro";
import ExternalLink from "../../components/ExternalLink.astro";

export async function getStaticPaths() {
  const bits = await getPublished("bits");
  return bits.map((bit) => ({
    params: { slug: bit.slug },
    props: bit,
  }));
}

export const prerender = true;
type Props = CollectionEntry<"bits">;
const bit = Astro.props;
const { Content, remarkPluginFrontmatter } = await bit.render();
---

<BitPost {...bit.data} frontmatter={remarkPluginFrontmatter}>
  <Content
    components={{
      a: ExternalLink,
    }}
  />
</BitPost>

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
  integrity="sha384-MlJdn/WNKDGXveldHDdyRP1R4CTHr3FeuDNfhsLPYrq2t0UBkUdK2jyTnXPEK1NQ"
  crossorigin="anonymous"
/>
