---
import { getPublished } from "../utils/content";
import PostRow from "../components/cards/PostRow.astro";
import BitRow from "../components/cards/BitRow.astro";
import Zone from "../components/Zone.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import RootLayout from "../layouts/RootLayout.astro";

const recentPosts = (await getPublished("blog")).slice(0, 3);
const recentBits = (await getPublished("bits")).slice(0, 3);
---

<RootLayout meta={{ title: SITE_TITLE, description: SITE_DESCRIPTION }}>
  <div class="mx-auto w-full max-w-index px-5 pb-4 pt-8 lg:px-8">
    <!-- Bio plate: who made this board, and where to read more. -->
    <section
      class="mb-12 rounded-part border border-silk-faint/40 bg-mask-raised
             px-5 py-6 sm:px-7 sm:py-7"
    >
      <div class="mb-4 flex items-baseline gap-3">
        <h2 class="legend text-copper-light">Author</h2>
        <span aria-hidden="true" class="h-px flex-1 bg-silk-faint/35"></span>
      </div>

      <h1 class="font-display text-3xl font-bold text-silk">Derock X.</h1>
      <p class="mt-2.5 max-w-[46ch] text-silk-dim">
        I build things that have to survive contact with the real world: a
        3.4&nbsp;GHz video downlink for a rocket, competition robots, a home
        server rack, the occasional CTF flag. This is where I write down how
        they work.
      </p>
      <p class="mt-4">
        <a href="https://derock.dev/?ref=blog" class="pad font-mono text-data">
          more about me at derock.dev &rarr;
        </a>
      </p>
    </section>

    <Zone label="Recent posts" href="/posts" linkLabel="all posts" class="mb-14">
      <div class="flex flex-col gap-4">
        {
          recentPosts.map((post, i) => (
            <PostRow blog={post} lead={i === 0} />
          ))
        }
      </div>
    </Zone>

    <Zone label="Recent bits" href="/bits" linkLabel="all bits">
      <p class="-mt-1 mb-4 text-sm text-silk-dim">
        Short TIL-style findings: quick discoveries, tips, and observations that
        don't warrant a full post.
      </p>
      {
        recentBits.length > 0 ? (
          <div class="flex flex-col gap-4">
            {recentBits.map((bit) => (
              <BitRow bit={bit} />
            ))}
          </div>
        ) : (
          <p class="zone px-5 py-6 text-sm text-silk-dim">
            No bits yet. Check back soon.
          </p>
        )
      }
    </Zone>
  </div>
</RootLayout>
