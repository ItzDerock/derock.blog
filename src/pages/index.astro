---
import { getPublished } from "../utils/content";
import PostRow from "../components/cards/PostRow.astro";
import BitRow from "../components/cards/BitRow.astro";
import Zone from "../components/Zone.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import RootLayout from "../layouts/RootLayout.astro";

const allPosts = await getPublished("blog");
const recentPosts = allPosts.slice(0, 3);
const morePosts = allPosts.length - recentPosts.length;
const recentBits = (await getPublished("bits")).slice(0, 3);
---

<RootLayout meta={{ title: SITE_TITLE, description: SITE_DESCRIPTION }}>
  <div class="mx-auto w-full max-w-index px-5 pb-4 pt-8 lg:px-8">
    <!-- Bio plate: who made this board, and where to read more. -->
    <section
      class="mb-12 rounded-part border border-silk-faint/40 bg-mask-raised
             px-5 py-6 sm:px-7 sm:py-7"
    >
      <div class="mb-4 flex items-baseline gap-3">
        <h2 class="legend text-copper-light">Author</h2>
        <span aria-hidden="true" class="h-px flex-1 bg-silk-faint/35"></span>
      </div>

      <h1 class="font-display text-3xl font-bold text-silk">Derock X.</h1>
      <p class="mt-2.5 max-w-[46ch] text-silk-dim">
        I like to build things, and afterwards, I like to write about them.
        Electrical Engineer & Computer Science student, self-proclamed hacker.
        Big into open-source and tech independence.
      </p>
      <p class="mt-4">
        <a href="https://derock.dev/?ref=blog" class="pad font-mono text-data">
          more about me at derock.dev &rarr;
        </a>
      </p>
    </section>

    <Zone
      label="Recent posts"
      href="/posts"
      linkLabel="all posts"
      class="mb-14"
    >
      <div class="flex flex-col gap-4">
        {recentPosts.map((post, i) => <PostRow blog={post} lead={i === 0} />)}

        <!--
          The rule-top link alone let readers stop at three and conclude that
          was the whole board. This is the next footprint in the column,
          drawn but unpopulated: same width and rhythm as a PostRow, hairline
          dashed instead of seated, so it reads as "the run continues" rather
          than as a fourth post.
        -->
        {
          morePosts > 0 && (
            <a href="/posts" class="group block no-underline">
              <div class="zone flex items-center justify-between gap-3 border-dashed px-5 py-4 transition-colors group-hover:border-copper">
                <span class="legend text-silk transition-colors group-hover:text-gold">
                  + {morePosts} more post{morePosts === 1 ? "" : "s"}
                </span>
                <span class="designator transition-colors group-hover:text-gold-bright">
                  read all &rarr;
                </span>
              </div>
            </a>
          )
        }
      </div>
    </Zone>

    <Zone label="Recent bits" href="/bits" linkLabel="all bits">
      <p class="-mt-1 mb-4 text-sm text-silk-dim">
        Short TIL-style findings: quick discoveries, tips, and observations that
        don't warrant a full post.
      </p>
      {
        recentBits.length > 0 ? (
          <div class="flex flex-col gap-4">
            {recentBits.map((bit) => (
              <BitRow bit={bit} />
            ))}
          </div>
        ) : (
          <p class="zone px-5 py-6 text-sm text-silk-dim">
            No bits yet. Check back soon.
          </p>
        )
      }
    </Zone>
  </div>
</RootLayout>
