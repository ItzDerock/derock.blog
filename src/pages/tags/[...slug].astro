---
import { getPublished } from "../../utils/content";
import PostRow from "../../components/cards/PostRow.astro";
import RootLayout from "../../layouts/RootLayout.astro";

export const prerender = true;

export async function getStaticPaths() {
  const blogs = await getPublished("blog");
  return [...new Set(blogs.flatMap((blog) => blog.data.tags))].map((tag) => ({
    params: { slug: tag },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/posts");
}

const posts = (await getPublished("blog")).filter((post) =>
  post.data.tags.includes(slug)
);

const description = `${posts.length} post${posts.length === 1 ? "" : "s"} tagged "${slug}": ${posts
  .map((post) => post.data.title)
  .join(", ")}.`;
---

<RootLayout meta={{ title: `Tagged ${slug} | derock.blog`, description }}>
  <div class="mx-auto w-full max-w-index px-5 pb-4 pt-8 lg:px-8">
    <header class="mb-8">
      <div class="mb-3 flex items-baseline gap-3">
        <span class="legend text-copper-light">Tagged</span>
        <span aria-hidden="true" class="h-px flex-1 bg-silk-faint/35"></span>
        <span class="legend">
          {posts.length} post{posts.length === 1 ? "" : "s"}
        </span>
      </div>
      <h1 class="font-display text-3xl font-bold text-silk">#{slug}</h1>
      <p class="mt-3">
        <a href="/posts" class="pad font-mono text-data">&larr; all posts</a>
      </p>
    </header>

    <div class="flex flex-col gap-4">
      {posts.map((post) => <PostRow blog={post} />)}
    </div>
  </div>
</RootLayout>
