---
import { getPublished } from "../utils/content";
import BitRow from "../components/cards/BitRow.astro";
import RootLayout from "../layouts/RootLayout.astro";

const bits = await getPublished("bits");
---

<RootLayout
  meta={{
    title: "Bits | derock.blog",
    description:
      "Short TIL-style findings: quick discoveries, tips, and observations.",
  }}
>
  <div class="mx-auto w-full max-w-index px-5 pb-4 pt-8 lg:px-8">
    <header class="mb-8">
      <div class="mb-3 flex items-baseline gap-3">
        <span class="legend text-copper-light">Test points</span>
        <span aria-hidden="true" class="h-px flex-1 bg-silk-faint/35"></span>
        <span class="legend">{bits.length} bits</span>
      </div>
      <h1 class="font-display text-3xl font-bold text-silk">Bits</h1>
      <p class="mt-2 max-w-[52ch] text-silk-dim">
        Short TIL-style findings: quick discoveries, tips, and observations that
        don't warrant a full post.
      </p>
    </header>

    {
      bits.length > 0 ? (
        <div class="flex flex-col gap-4">
          {bits.map((bit) => (
            <BitRow bit={bit} />
          ))}
        </div>
      ) : (
        <p class="zone px-5 py-6 text-sm text-silk-dim">
          No bits yet. Check back soon.
        </p>
      )
    }
  </div>
</RootLayout>
