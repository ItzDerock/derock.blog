---

---

<div>
  <style>
    .control-panel {
      height: 0;
      overflow: hidden;
      transition: height 0.3s ease-out;
    }

    .control-panel.expanded {
      height: 120px;
    }

    .graph-container {
      background: #f8f9fa;
      border-radius: 4px;
    }

    .slider-container {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 10px 0;
    }

    .slider-label {
      width: 30px;
      text-align: right;
    }

    input[type="range"] {
      flex-grow: 1;
    }

    .value-display {
      width: 50px;
    }
  </style>
</div>
<body>
  <div class="max-w-xl mx-auto p-4">
    <div class="border rounded-lg p-4 bg-white shadow-sm">
      <!-- Top visualization area -->
      <svg id="position-view" width="100%" height="60"></svg>

      <!-- Graph area -->
      <div class="graph-container mt-4">
        <svg id="pid-graph" width="100%" height="120"></svg>
      </div>

      <!-- Controls -->
      <div class="mt-4">
        <div class="flex gap-2">
          <button
            class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300"
            onclick="toggleComponent('p')">P</button
          >
          <button
            class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300"
            onclick="toggleComponent('i')">I</button
          >
          <button
            class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300"
            onclick="toggleComponent('d')">D</button
          >
          <button
            class="px-3 py-1 bg-gray-200 rounded hover:bg-gray-300"
            onclick="toggleComponent('error')">Error</button
          >
        </div>
        <button
          class="mt-2 px-3 py-1 bg-blue-500 text-white rounded hover:bg-blue-600"
          onclick="toggleControlPanel()">Configure</button
        >
      </div>

      <!-- Control panel (initially hidden) -->
      <div id="control-panel" class="control-panel mt-4">
        <div class="slider-container">
          <span class="slider-label">kP:</span>
          <input
            type="range"
            min="0"
            max="2"
            step="0.1"
            value="1"
            oninput="updatePIDValues('p', this.value)"
          />
          <span class="value-display" id="kp-value">1.0</span>
        </div>
        <div class="slider-container">
          <span class="slider-label">kI:</span>
          <input
            type="range"
            min="0"
            max="2"
            step="0.1"
            value="0.1"
            oninput="updatePIDValues('i', this.value)"
          />
          <span class="value-display" id="ki-value">0.1</span>
        </div>
        <div class="slider-container">
          <span class="slider-label">kD:</span>
          <input
            type="range"
            min="0"
            max="2"
            step="0.1"
            value="0.2"
            oninput="updatePIDValues('d', this.value)"
          />
          <span class="value-display" id="kd-value">0.2</span>
        </div>
      </div>
    </div>
  </div>

  <script>
    import d3 from "d3";

    // PID Controller state
    const state = {
      setpoint: 0.7,
      position: 0.3,
      time: 0,
      history: [],
      visibleComponents: new Set(["p", "i", "d", "error"]),
      kp: 1.0,
      ki: 0.1,
      kd: 0.2,
      lastError: 0,
      integral: 0,
    };

    // Initialize position view
    const positionView = d3.select("#position-view");

    // Draw track
    positionView
      .append("line")
      .attr("x1", 40)
      .attr("x2", 460)
      .attr("y1", 30)
      .attr("y2", 30)
      .attr("stroke", "black")
      .attr("stroke-width", 2);

    // Draw setpoint
    positionView
      .append("circle")
      .attr("cx", 40 + state.setpoint * 420)
      .attr("cy", 30)
      .attr("r", 6)
      .attr("fill", "red");

    // Draw robot
    const robot = positionView
      .append("rect")
      .attr("x", 40 + state.position * 420 - 10)
      .attr("y", 20)
      .attr("width", 20)
      .attr("height", 20)
      .attr("fill", "blue");

    // Initialize PID graph
    const pidGraph = d3.select("#pid-graph");
    const margin = { top: 10, right: 20, bottom: 20, left: 40 };
    const width =
      pidGraph.node().getBoundingClientRect().width -
      margin.left -
      margin.right;
    const height = 120 - margin.top - margin.bottom;

    const x = d3.scaleLinear().domain([0, 100]).range([0, width]);
    const y = d3.scaleLinear().domain([-1, 1]).range([height, 0]);

    const g = pidGraph
      .append("g")
      .attr("transform", `translate(${margin.left},${margin.top})`);

    // Add axes
    g.append("g")
      .attr("transform", `translate(0,${height / 2})`)
      .call(d3.axisBottom(x));

    g.append("g").call(d3.axisLeft(y));

    // Line generators
    const line = d3
      .line()
      .x((d) => x(d.time))
      .y((d) => y(d.value));

    // Initialize lines
    const errorLine = g
      .append("path")
      .attr("fill", "none")
      .attr("stroke", "red")
      .attr("stroke-width", 1.5);

    const pLine = g
      .append("path")
      .attr("fill", "none")
      .attr("stroke", "blue")
      .attr("stroke-width", 1.5);

    const iLine = g
      .append("path")
      .attr("fill", "none")
      .attr("stroke", "green")
      .attr("stroke-width", 1.5);

    const dLine = g
      .append("path")
      .attr("fill", "none")
      .attr("stroke", "purple")
      .attr("stroke-width", 1.5);

    function updatePIDValues(component, value) {
      const valueDisplay = document.getElementById(`k${component}-value`);
      valueDisplay.textContent = parseFloat(value).toFixed(1);

      switch (component) {
        case "p":
          state.kp = parseFloat(value);
          break;
        case "i":
          state.ki = parseFloat(value);
          break;
        case "d":
          state.kd = parseFloat(value);
          break;
      }
    }

    function toggleComponent(component) {
      if (state.visibleComponents.has(component)) {
        state.visibleComponents.delete(component);
      } else {
        state.visibleComponents.add(component);
      }
    }

    function toggleControlPanel() {
      const panel = document.getElementById("control-panel");
      panel.classList.toggle("expanded");
    }

    function updateVisualization() {
      // Calculate error
      const error = state.setpoint - state.position;

      // Calculate PID components
      const p = error * state.kp;
      state.integral += error * 0.016; // Assuming 60fps -> dt = 1/60
      const i = state.integral * state.ki;
      const d = ((error - state.lastError) / 0.016) * state.kd;

      // Update position based on PID output
      const output = p + i + d;
      state.position += output * 0.016;
      state.position = Math.max(0, Math.min(1, state.position));

      // Update robot position
      robot.attr("x", 40 + state.position * 420 - 10);

      // Store history
      state.history.push({
        time: state.time,
        error: error,
        p: p,
        i: i,
        d: d,
      });

      // Trim history
      if (state.history.length > 100) {
        state.history.shift();
      }

      // Update graph
      if (state.visibleComponents.has("error")) {
        errorLine.attr(
          "d",
          line(state.history.map((d) => ({ time: d.time, value: d.error }))),
        );
      } else {
        errorLine.attr("d", "");
      }

      if (state.visibleComponents.has("p")) {
        pLine.attr(
          "d",
          line(state.history.map((d) => ({ time: d.time, value: d.p }))),
        );
      } else {
        pLine.attr("d", "");
      }

      if (state.visibleComponents.has("i")) {
        iLine.attr(
          "d",
          line(state.history.map((d) => ({ time: d.time, value: d.i }))),
        );
      } else {
        iLine.attr("d", "");
      }

      if (state.visibleComponents.has("d")) {
        dLine.attr(
          "d",
          line(state.history.map((d) => ({ time: d.time, value: d.d }))),
        );
      } else {
        dLine.attr("d", "");
      }

      state.lastError = error;
      state.time += 1;

      requestAnimationFrame(updateVisualization);
    }

    updateVisualization();
  </script>
</body>
