---
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();

const contacts = [
  { href: "https://derock.dev/?ref=blog", icon: "mdi:web", label: "Portfolio" },
  {
    href: "https://github.com/ItzDerock",
    icon: "fa6-brands:github",
    label: "GitHub",
  },
  {
    href: "https://discord.gg/Fbm7AeazHQ",
    icon: "fa6-brands:discord",
    label: "Discord",
  },
  {
    href: "https://twitter.com/derockgamer",
    icon: "fa6-brands:x-twitter",
    label: "Twitter / X",
  },
  { href: "/rss.xml", icon: "mdi:rss", label: "RSS feed" },
];
---

<!-- The revision block: the stamp in the corner of every fab drawing. -->
<footer class="mt-20 border-t border-copper/45 bg-mask-raised">
  <div
    class="mx-auto flex max-w-board flex-col gap-6 px-5 py-8
           sm:flex-row sm:items-end sm:justify-between lg:px-8"
  >
    <dl class="grid grid-cols-[auto_1fr] gap-x-5 gap-y-1.5">
      <dt class="legend">Sheet</dt>
      <dd class="font-mono text-data text-silk">derock.blog</dd>
      <dt class="legend">Author</dt>
      <dd class="font-mono text-data text-silk">Derock X.</dd>
      <dt class="legend">Rev</dt>
      <dd class="font-mono text-data text-silk-dim">
        v2 &middot; &copy; {year}
      </dd>
    </dl>

    <ul class="flex flex-row items-center gap-1.5">
      {
        contacts.map((contact) => (
          <li>
            <a
              href={contact.href}
              target={contact.href.startsWith("http") ? "_blank" : undefined}
              rel={
                contact.href.startsWith("http")
                  ? "noopener noreferrer"
                  : undefined
              }
              aria-label={contact.label}
              title={contact.label}
              class="flex h-9 w-9 items-center justify-center rounded-pad
                     border border-silk-faint/35 text-silk-dim
                     transition-colors hover:border-gold hover:text-gold"
            >
              <Icon name={contact.icon} size={17} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
